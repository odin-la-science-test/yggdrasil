{
  "installCommand": "npm --prefix react-app install",
  "buildCommand": "npm --prefix react-app run build",
  "rewrites": [
    { "source": "/", "destination": "/Yggdrasil Racines.dc.html" },
    { "source": "/app(/*)", "destination": "/react-app/dist/index.html" }
  ],
  "staticFiles": {
    "include": ["Yggdrasil Racines.dc.html", "support.js", "assets/**", "react-app/dist/**"]
  }
}
