{
  "installCommand": "npm --prefix react-app install",
  "buildCommand": "npm --prefix react-app run build && cp 'Yggdrasil Racines.dc.html' index.html",
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/app(/*)", "destination": "/react-app/dist/index.html" },
    { "source": "/app/assets/(.*)", "destination": "/react-app/dist/assets/$1" }
  ]
}
